    {
      "parameters": {
        "jsCode": "\nconst THRESHOLD = 0.7; \n\nfunction normalize(text) {\n  return String(text ?? '')\n    .toLowerCase()\n    .replace(/[^\\p{L}\\p{N}\\s]/gu, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\n\nfunction levenshtein(a, b) {\n  const rows = a.length + 1;\n  const cols = b.length + 1;\n  const dp = Array.from({ length: rows }, () => new Array(cols).fill(0));\n\n  // Base cases: turning a string into an empty one (and back) costs its length\n  for (let i = 0; i < rows; i++) dp[i][0] = i;\n  for (let j = 0; j < cols; j++) dp[0][j] = j;\n\n  for (let i = 1; i < rows; i++) {\n    for (let j = 1; j < cols; j++) {\n      const cost = a[i - 1] === b[j - 1] ? 0 : 1;\n      dp[i][j] = Math.min(\n        dp[i - 1][j] + 1,        \n        dp[i][j - 1] + 1,        \n        dp[i - 1][j - 1] + cost \n      );\n    }\n  }\n\n  return dp[a.length][b.length];\n}\n\n// Turn the distance into a 0..1 score that is comparable between\n// short and long strings: 1 = identical, 0 = completely different.\nfunction similarity(a, b) {\n  const longest = Math.max(a.length, b.length);\n  if (longest === 0) return 1; // both empty\n  return 1 - levenshtein(a, b) / longest;\n}\n\n\nconst msg = $('Telegram Trigger').first().json.message;\nconst userQuestion = normalize(msg.text);\nconst faqRows = $input.all().map(item => item.json);\n\n\nlet best = { score: 0, question: null, answer: null };\n\nfor (const row of faqRows) {\n  if (!row.question || !row.answer) continue; \n\n  const score = similarity(userQuestion, normalize(row.question));\n  if (score > best.score) {\n    best = { score, question: row.question, answer: row.answer };\n  }\n}\n\n\nreturn [{\n  json: {\n    matched: best.score >= THRESHOLD,\n    score: Number(best.score.toFixed(3)),\n    threshold: THRESHOLD,\n    bestQuestion: best.question,\n    answer: best.answer,\n    question: msg.text,\n    chatId: msg.chat.id,\n    user: msg.from.username || msg.from.first_name,\n  },\n}];"
      },
